{
  "name": "dsh-mesh-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Device mesh panel for DeepSeek Harness: command other machines from one Desktop",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "locale", "icon.svg", "cordis.patch.yml", "docs"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  },
  "engines": { "dsh": ">=0.2.1-rc.5" },
  "license": "MIT"
}
