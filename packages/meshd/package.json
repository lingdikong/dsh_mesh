{
  "name": "dsh-meshd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "meshd": "./dist/cli.js" },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js up",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/meshd.cjs --external:bufferutil --external:utf-8-validate"
  },
  "dependencies": {
    "@dsh-mesh/protocol": "workspace:*",
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
